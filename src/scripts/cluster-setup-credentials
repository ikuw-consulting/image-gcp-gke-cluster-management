#!/usr/bin/env bash
set -euo pipefail

: "${GCP_PROJECT_ID:?GCP_PROJECT_ID is required}"
: "${GKE_CLUSTER_NAME:?GKE_CLUSTER_NAME is required}"
: "${GKE_CLUSTER_LOCATION:?GKE_CLUSTER_LOCATION is required}"

gcloud config set project "${GCP_PROJECT_ID}" >/dev/null

if gcloud container clusters get-credentials "${GKE_CLUSTER_NAME}" \
  --region "${GKE_CLUSTER_LOCATION}" \
  --project "${GCP_PROJECT_ID}"; then
  exit 0
fi

gcloud container clusters get-credentials "${GKE_CLUSTER_NAME}" \
  --zone "${GKE_CLUSTER_LOCATION}" \
  --project "${GCP_PROJECT_ID}"
